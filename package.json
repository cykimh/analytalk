{
  "name": "analytalk",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check:samples": "tsx scripts/check-samples.ts",
    "skeletonize": "tsx scripts/skeletonize.ts",
    "invite:add": "tsx --env-file=.env.local scripts/invite.ts add",
    "invite:revoke": "tsx --env-file=.env.local scripts/invite.ts revoke",
    "measure": "tsx --conditions=react-server --env-file=.env.local scripts/measure.ts",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/functions": "^3.11.3",
    "@zip.js/zip.js": "^2.25.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
