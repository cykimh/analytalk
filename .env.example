# 로컬 개발용. 이 파일을 .env.local 로 복사해 채운다 (.env.local 은 커밋하지 않는다).
# 로컬 Supabase 값: sideinfra 에서 `supabase status -o env` 의 API_URL / PUBLISHABLE_KEY
# 배포 환경 값은 저장소에 두지 않고 Vercel 환경 변수(비밀값은 Sensitive)로만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀값 (Vercel Sensitive). 값이 없으면 프로덕션은 503
ANTHROPIC_API_KEY=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
SESSION_SECRET=
INTERNAL_HMAC_SECRET=

# 선택
ANTHROPIC_MODEL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
EPISODE_MAX_TOKENS=
ANALYTALK_SAMPLES_DIR=
