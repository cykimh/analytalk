# 로컬 개발용. 이 파일을 .env.local 로 복사해 채운다 (.env.local 은 커밋하지 않는다).
# 로컬 Supabase 값: sideinfra 에서 `supabase status -o env` 의 API_URL / PUBLISHABLE_KEY
# 배포 환경 값은 저장소에 두지 않고 Vercel 환경 변수로만 넣는다 (sideinfra scripts/app.sh vercel).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
