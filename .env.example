# 로컬 개발용. 이 파일을 .env.local 로 복사해 채운다 (.env.local 은 커밋하지 않는다).
# 로컬 Supabase 값: sideinfra 에서 `supabase status -o env` 의 API_URL / SECRET_KEY
# 앱의 DB 접근은 서버의 secret 키로만 한다(analytalk 테이블은 RLS 정책 0개). 브라우저용 publishable 키는 쓰지 않는다.
# SUPABASE_SECRET_KEY 가 비어 있으면 개발 서버는 메모리 저장소로 돈다(재시작하면 사라짐).
# 배포 환경 값은 저장소에 두지 않고 Vercel 환경 변수(비밀값은 Sensitive)로만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 비밀값 (Vercel Sensitive). 값이 없으면 프로덕션은 503
# 개발 서버에서 SESSION_SECRET·INTERNAL_HMAC_SECRET 이 비면 고정 개발 값, TURNSTILE_SECRET_KEY 가 비면 사람 확인을 건너뛴다
ANTHROPIC_API_KEY=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
SESSION_SECRET=
INTERNAL_HMAC_SECRET=

# 선택
ANTHROPIC_MODEL=
INPUT_TOKEN_BUDGET=
REPORT_MAX_TOKENS=
ANTHROPIC_EFFORT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
EPISODE_MAX_TOKENS=
ANALYTALK_SAMPLES_DIR=
